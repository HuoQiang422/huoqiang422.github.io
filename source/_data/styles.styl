// ============================================================
// 寒漓 · 中文阅读排版优化
// ============================================================

// --- 正文排版 ---
.post-body {
  // 中文最佳行高：1.7-1.9
  line-height: 1.85;
  // 段落间距
  p {
    margin-bottom: 1.2em;
  }
  // 首行缩进（中文段落传统）
  // 如需开启取消下面注释：
  // p {
  //   text-indent: 2em;
  // }
}

// --- 标题间距 ---
.post-body h1, .post-body h2, .post-body h3, .post-body h4 {
  margin-top: 1.8em;
  margin-bottom: 0.7em;
  font-weight: 700;
}

.post-body h2 {
  border-bottom: 1px solid #e8e8e8;
  padding-bottom: 0.3em;
}

// --- 字体平滑 ---
body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

// --- 正文最大宽度 — 中文每行35-42字最舒适 ---
.main-inner {
  max-width: 860px;
}

// --- 段落内强调 ---
.post-body strong {
  color: #c7254e;
  font-weight: 600;
}

// --- 引用块 ---
.post-body blockquote {
  border-left: 4px solid #3b82f6;
  background: #f8f9fa;
  padding: 0.8em 1.2em;
  margin: 1.2em 0;
  color: #555;
  font-size: 0.95em;
  line-height: 1.75;

  p {
    margin-bottom: 0.4em;
  }
}

// --- 分割线 ---
.post-body hr {
  margin: 2em 0;
  border: none;
  height: 1px;
  background: linear-gradient(to right, transparent, #ccc 20%, #ccc 80%, transparent);
}

// --- 暗色模式调整 ---
@media (prefers-color-scheme: dark) {
  .post-body blockquote {
    background: #1e1e1e;
    color: #aaa;
    border-left-color: #3b82f6;
  }
  .post-body strong {
    color: #f48771;
  }
  .post-body h2 {
    border-bottom-color: #333;
  }
}

// --- 文章列表间距 ---
.posts-expand .post-title {
  font-size: 1.4em;
  font-weight: 600;
  line-height: 1.5;
}

.posts-expand .post-meta {
  font-size: 0.85em;
  color: #999;
  margin: 0.5em 0 1.2em;
}

// --- 分类/标签页 ---
.category-list-link, .tag-cloud-link {
  font-size: 1em;
}

// --- 移动端适配 ---
@media (max-width: 767px) {
  .post-body {
    font-size: 15px;
    line-height: 1.75;
  }
  .post-body h1 {
    font-size: 1.5em;
  }
  .post-body h2 {
    font-size: 1.3em;
  }
  .main-inner {
    padding: 0 12px;
  }
}

// --- 阅读进度条 ---
.reading-progress-bar {
  background: linear-gradient(to right, #3b82f6, #06b6d4);
}

// --- 代码块行高 ---
code {
  word-break: break-word;
}
